{
  "description": "RushDB automatic context: recall at session start, capture of finished turns, flush before compaction and at session end. Off unless auto_context is set.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/rushdb-hooks.mjs\" recall --host codex",
            "timeout": 10,
            "additionalContextLimit": 4000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/rushdb-hooks.mjs\" capture --host codex",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/rushdb-hooks.mjs\" capture --host codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/rushdb-hooks.mjs\" precompact --host codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/rushdb-hooks.mjs\" end --host codex",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
